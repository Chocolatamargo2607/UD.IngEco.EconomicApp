/* Estilos para Tipografías Matemáticas Dinámicas */
.math-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 15px;
    background: rgba(15, 23, 42, 0.6);
    border-radius: 12px;
}

.math-formula {
    font-family: 'JetBrains Mono', 'Cambria Math', serif;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #f8fafc;
}

.math-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    text-transform: uppercase;
}

.var { font-style: italic; color: #10b981; }

/* Estructuración de Fracciones Visuales */
.fraction {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    vertical-align: middle;
    font-size: 0.9rem;
    margin: 0 4px;
}

.fraction .num { border-bottom: 1px solid #94a3b8; padding: 0 8px; }
.fraction .den { padding: 0 8px; }

.fraction.smaller {
    font-size: 0.7rem;
}

.fraction-parenthesis {
    display: inline-flex;
    align-items: center;
}
.fraction-parenthesis::before { content: '('; font-size: 1.8rem; font-weight: 300; margin-right: 2px; }
.fraction-parenthesis::after { content: ')'; font-size: 1.8rem; font-weight: 300; margin-left: 2px; }

/* Tarjetas y Layout */
.text-emerald { color: #10b981 !important; }
.text-emerald-dim { color: rgba(16, 185, 129, 0.75) !important; }

.content-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 20px;
    padding: 25px;
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
}

.formula-display {
    background: linear-gradient(145deg, #1e293b, #0f172a);
    border-left: 4px solid #10b981;
}

/* Caja de Resultados Clave */
.result-highlight-box {
    background: #0f172a;
    border: 2px solid rgba(16, 185, 129, 0.2);
    border-radius: 16px;
    padding: 25px;
}

/* Scroll para tablas de amortización muy largas */
.capital-table-container {
    max-height: 380px;
    overflow-y: auto;
    border-radius: 12px;
    border: 1px solid #334155;
}

.capital-table-container::-webkit-scrollbar {
    width: 5px;
}
.capital-table-container::-webkit-scrollbar-thumb {
    background: #475569;
    border-radius: 10px;
}

.custom-table {
    --bs-table-bg: transparent;
    vertical-align: middle;
    margin-bottom: 0;
}

/* Navegación interna (Tabs) */
.sub-nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.nav-btn {
    background: #1e293b;
    border: 1px solid #334155;
    color: #94a3b8;
    padding: 10px 18px;
    border-radius: 10px;
    transition: all 0.2s;
    cursor: pointer;
}

.nav-btn:hover {
    border-color: #475569;
    color: white;
}

.nav-btn.active {
    background: rgba(16, 185, 129, 0.1);
    border-color: #10b981;
    color: #10b981;
    font-weight: 600;
}

/* Formularios de entrada */
label {
    display: block;
    font-size: 0.75rem;
    color: #64748b;
    margin-bottom: 8px;
    font-weight: 700;
}

.form-control {
    background: #0f172a !important;
    border: 1px solid #334155 !important;
    color: white !important;
    border-radius: 10px;
}

.form-control:focus {
    border-color: #10b981 !important;
    box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.2) !important;
}

/* Empty State */
.empty-state { text-align: center; padding: 60px 20px; color: #94a3b8; }
.empty-icon-circle {
    width: 70px; height: 70px; background: #0f172a; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 20px; font-size: 2.2rem; color: #334155;
}

.animate-fadeIn { animation: fadeIn 0.4s ease-out; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }